  OpenBook Launcher design tokens (openbook/ROADMAP.md M2). Names and values follow OpenBook's
  docs/launcher-design.md: §2 (taskbar), §6 (tokens), §7 (motion). Colours are not here: they are Material roles read
  from the theme (@color/materialColor*), so they follow the wallpaper.
-->
<resources>
    <!-- §2.1 Taskbar geometry. The bar itself stays AOSP's 56 dp (taskbar_size), so window insets don't move. -->
    <dimen name="ob_tb_gap">4dp</dimen>
    <dimen name="ob_tb_radius">14dp</dimen>
    <!-- The row sits this far above the bar's centre, so each state line lies on the bar under its target. -->
    <dimen name="ob_tb_row_lift">2dp</dimen>
    <dimen name="ob_tb_pill_width">56dp</dimen>
    <dimen name="ob_tb_pill_height">40dp</dimen>
    <dimen name="ob_tb_glyph">20dp</dimen>
    <dimen name="ob_tb_divider_width">1dp</dimen>
    <dimen name="ob_tb_divider_height">24dp</dimen>
    <dimen name="ob_tb_divider_margin">8dp</dimen>
    <item name="ob_tb_divider_alpha" format="float" type="dimen">0.70</item>

    <!-- §2.3 One line of state, 1 dp under the 48 dp target. -->
    <dimen name="ob_ind_offset">1dp</dimen>
    <dimen name="ob_ind_height">3dp</dimen>
    <dimen name="ob_ind_run">6dp</dimen>
    <dimen name="ob_ind_front">16dp</dimen>
    <dimen name="ob_ind_min">8dp</dimen>
    <dimen name="ob_ind_stroke">1dp</dimen>
    <dimen name="ob_ind_dot">3dp</dimen>
    <dimen name="ob_ind_dot_gap">3dp</dimen>

    <!-- §2.4, §6.2 State layers (onSurface) and the focus ring. -->
    <item name="ob_state_hover" format="float" type="dimen">0.08</item>
    <item name="ob_state_front" format="float" type="dimen">0.06</item>
    <item name="ob_state_front_hover" format="float" type="dimen">0.12</item>
    <item name="ob_state_pressed" format="float" type="dimen">0.12</item>
    <item name="ob_press_scale" format="float" type="dimen">0.92</item>
    <dimen name="ob_focus_ring">2dp</dimen>
    <dimen name="ob_focus_ring_offset">2dp</dimen>

    <!-- §2.4 Tooltip. -->
    <dimen name="ob_tip_height">28dp</dimen>
    <dimen name="ob_tip_padding_h">12dp</dimen>
    <dimen name="ob_tip_gap">8dp</dimen>
    <integer name="ob_tip_delay_ms">500</integer>

    <!-- §6.3 Glass. -->
    <dimen name="ob_glass_blur">34dp</dimen>
    <dimen name="ob_glass_edge">1dp</dimen>
    <item name="ob_glass_alpha" format="float" type="dimen">0.80</item>
    <!-- Blur off (battery saver, thermal, Developer options) or unavailable: the same layout, tint only. -->
    <item name="ob_glass_solid_alpha" format="float" type="dimen">0.96</item>

    <!-- §3.1 All Apps panel: 6 columns of 112 dp plus 24 dp each side is 720 dp. Its height fits the apps
         (header + rows × cell + bottom), at most ob_aa_max_height and the space above the taskbar less
         ob_aa_screen_margin; its bottom is ob_aa_gap above the taskbar. -->
    <integer name="ob_aa_columns">6</integer>
    <dimen name="ob_aa_column">112dp</dimen>
    <dimen name="ob_aa_inset">24dp</dimen>
    <dimen name="ob_aa_header">84dp</dimen>
    <dimen name="ob_aa_bottom">28dp</dimen>
    <dimen name="ob_aa_max_height">640dp</dimen>
    <dimen name="ob_aa_screen_margin">24dp</dimen>
    <dimen name="ob_aa_gap">12dp</dimen>
    <dimen name="ob_aa_radius">28dp</dimen>
    <!-- §3.1 The search field: a 48 dp pill, a 20 dp icon, text 16/24. -->
    <dimen name="ob_aa_field_height">48dp</dimen>
    <dimen name="ob_aa_field_icon">20dp</dimen>
    <dimen name="ob_aa_field_padding">16dp</dimen>
    <dimen name="ob_aa_field_icon_gap">12dp</dimen>
    <dimen name="ob_aa_field_text">16sp</dimen>
    <dimen name="ob_aa_field_line">24sp</dimen>
    <item name="ob_aa_paper_alpha_light" format="float" type="dimen">0.80</item>
    <item name="ob_aa_paper_alpha_dark" format="float" type="dimen">0.85</item>
    <!-- §3.2 The grid: 112 × 104 dp cells, a 52 dp icon 12 dp from the top, a 100 dp label 8 dp under it, at
         13/16 and weight 450, two lines at most. -->
    <dimen name="ob_aa_cell_height">104dp</dimen>
    <dimen name="ob_aa_icon">52dp</dimen>
    <dimen name="ob_aa_icon_top">12dp</dimen>
    <dimen name="ob_aa_label_gap">8dp</dimen>
    <dimen name="ob_aa_label_width">100dp</dimen>
    <dimen name="ob_aa_label_text">13sp</dimen>
    <dimen name="ob_aa_label_line">16sp</dimen>
    <integer name="ob_aa_label_weight">450</integer>
    <dimen name="ob_aa_cell_radius">16dp</dimen>
    <item name="ob_state_top_hit" format="float" type="dimen">0.10</item>
    <item name="ob_aa_press_scale" format="float" type="dimen">0.96</item>
    <!-- §3.3 No results: 14/20 in soft ink. -->
    <dimen name="ob_aa_empty_text">14sp</dimen>
    <dimen name="ob_aa_empty_line">20sp</dimen>
    <dimen name="ob_aa_empty_top">40dp</dimen>
    <!-- §3.4 Open: scale 0.96 → 1 from the bottom centre and a 16 dp rise on spring.panel, opacity on
         duration.fade, the grid fading in after 40 ms. Close: duration.exit to 0.98 and an 8 dp fall. -->
    <item name="ob_aa_open_scale" format="float" type="dimen">0.96</item>
    <dimen name="ob_aa_rise">16dp</dimen>
    <item name="ob_aa_close_scale" format="float" type="dimen">0.98</item>
    <dimen name="ob_aa_fall">8dp</dimen>

    <!-- §6.3 Panel shadow: 0 24 48 and 0 2 6 (offset, blur), light and dark. -->
    <dimen name="ob_shadow_key_y">24dp</dimen>
    <dimen name="ob_shadow_key_blur">48dp</dimen>
    <dimen name="ob_shadow_ambient_y">2dp</dimen>
    <dimen name="ob_shadow_ambient_blur">6dp</dimen>

    <!-- §4 Menus: one glass menu for the desktop, a taskbar icon and an All Apps icon. 224 to 320 dp wide, 6 dp
         padding, 16 dp corners; 36 dp rows (48 dp opened by touch) with 10 dp corners and 12 dp sides; 20 dp icons
         12 dp before the label (14/20, weight 450); hints 12/16; dividers 1 dp with 6 dp above and below, inset
         12 dp; the taskbar menu's 44 dp header (a 24 dp icon, the name at weight 600) and its windows (a 20 × 14 dp
         outline, the front one in `primary` at 1.5 dp). Desktop menus open at the pointer, flipping at the edges
         ob_mn_margin from them; taskbar menus are centred over the icon, ob_mn_bar_gap above the bar. -->
    <dimen name="ob_mn_min_width">224dp</dimen>
    <dimen name="ob_mn_max_width">320dp</dimen>
    <dimen name="ob_mn_padding">6dp</dimen>
    <dimen name="ob_mn_radius">16dp</dimen>
    <dimen name="ob_mn_row">36dp</dimen>
    <dimen name="ob_mn_row_touch">48dp</dimen>
    <dimen name="ob_mn_row_radius">10dp</dimen>
    <dimen name="ob_mn_row_padding">12dp</dimen>
    <dimen name="ob_mn_icon">20dp</dimen>
    <dimen name="ob_mn_icon_gap">12dp</dimen>
    <dimen name="ob_mn_hint_gap">16dp</dimen>
    <dimen name="ob_mn_text">14sp</dimen>
    <dimen name="ob_mn_line">20sp</dimen>
    <integer name="ob_mn_weight">450</integer>
    <integer name="ob_mn_weight_strong">600</integer>
    <dimen name="ob_mn_hint_text">12sp</dimen>
    <dimen name="ob_mn_hint_line">16sp</dimen>
    <dimen name="ob_mn_divider">1dp</dimen>
    <dimen name="ob_mn_divider_margin">6dp</dimen>
    <item name="ob_mn_divider_alpha" format="float" type="dimen">0.50</item>
    <dimen name="ob_mn_header">44dp</dimen>
    <dimen name="ob_mn_header_icon">24dp</dimen>
    <dimen name="ob_mn_header_gap">10dp</dimen>
    <dimen name="ob_mn_thumb_width">20dp</dimen>
    <dimen name="ob_mn_thumb_height">14dp</dimen>
    <dimen name="ob_mn_thumb_radius">3dp</dimen>
    <dimen name="ob_mn_thumb_stroke">1dp</dimen>
    <dimen name="ob_mn_thumb_stroke_front">1.5dp</dimen>
    <dimen name="ob_mn_margin">8dp</dimen>
    <dimen name="ob_mn_bar_gap">8dp</dimen>
    <!-- The menu's shadow (§4): 0 12 32, lighter than a panel's; the ambient layer is the panels' 0 2 6. -->
    <dimen name="ob_mn_shadow_key_y">12dp</dimen>
    <dimen name="ob_mn_shadow_key_blur">32dp</dimen>
    <!-- §4 Motion: open scales from 0.94 about the anchor's corner on spring.panel with a fade on duration.fade;
         close fades in 100 ms on duration.exit's curve. -->
    <item name="ob_mn_open_scale" format="float" type="dimen">0.94</item>

    <!-- §5.2 Overview for desks. The backdrop: the glass blur (ob_glass_blur) under `surface` at 18 % (light) or
         30 % (dark). Tiles: 20 dp corners for a desk, 16 dp for an app; a 1 dp lit outline (the glass outline) and a
         soft shadow, 0 16 40 at 20 % black; hover lifts a tile 4 dp on spring.settle with a deeper shadow, 0 24 56 at
         26 %; keyboard focus is a two-colour ring outside the edge, three 2 dp bands (surfaceContainerLowest,
         onPrimaryContainer, surfaceContainerLowest; WCAG technique C40). Clear all: a 40 dp glass chip, its bottom
         40 dp above the taskbar, an 18 dp glyph 8 dp before "Clear all" at 14/20 and weight 500, padding 14 and 18. -->
    <item name="ob_ov_scrim_light" format="float" type="dimen">0.18</item>
    <item name="ob_ov_scrim_dark" format="float" type="dimen">0.30</item>
    <dimen name="ob_ov_desk_radius">20dp</dimen>
    <dimen name="ob_ov_app_radius">16dp</dimen>
    <dimen name="ob_ov_lift">4dp</dimen>
    <dimen name="ob_ov_ring_band">2dp</dimen>
    <dimen name="ob_ov_shadow_y">16dp</dimen>
    <dimen name="ob_ov_shadow_blur">40dp</dimen>
    <item name="ob_ov_shadow_alpha" format="float" type="dimen">0.20</item>
    <dimen name="ob_ov_shadow_hover_y">24dp</dimen>
    <dimen name="ob_ov_shadow_hover_blur">56dp</dimen>
    <item name="ob_ov_shadow_hover_alpha" format="float" type="dimen">0.26</item>
    <dimen name="ob_ov_chip_height">40dp</dimen>
    <dimen name="ob_ov_chip_above_bar">40dp</dimen>
    <dimen name="ob_ov_chip_icon">18dp</dimen>
    <dimen name="ob_ov_chip_gap">8dp</dimen>
    <dimen name="ob_ov_chip_padding_start">14dp</dimen>
    <dimen name="ob_ov_chip_padding_end">18dp</dimen>
    <dimen name="ob_ov_chip_text">14sp</dimen>
    <dimen name="ob_ov_chip_line">20sp</dimen>
    <integer name="ob_ov_chip_weight">500</integer>
    <!-- §5.2 Labels: a 28 dp glass chip 12 dp above the tile; a 20 dp icon 4 dp from the start, 8 dp before the
         name at 13/18 and weight 500, 12 dp after it. -->
    <dimen name="ob_ov_label_height">28dp</dimen>
    <dimen name="ob_ov_label_above">12dp</dimen>
    <dimen name="ob_ov_label_icon">20dp</dimen>
    <dimen name="ob_ov_label_padding_start">4dp</dimen>
    <dimen name="ob_ov_label_padding_end">12dp</dimen>
    <dimen name="ob_ov_label_gap">8dp</dimen>
    <dimen name="ob_ov_label_text">13sp</dimen>
    <dimen name="ob_ov_label_line">18sp</dimen>
    <integer name="ob_ov_label_weight">500</integer>

    <!-- §7 Motion: the springs and durations are code, openbook/OpenBookMotion, shared with Quire's Motion. -->

    <item type="id" name="openbook_taskbar_icon_state" />
    <item type="id" name="openbook_allapps_cell_state" />
    <item type="id" name="openbook_clear_all_chip" />
    <item type="id" name="openbook_menu_glass" />

    <!-- §3.3 Our own wording; English only, like the rest of OpenBook's strings here. -->
    <string name="ob_aa_no_results" translatable="false">No apps match “%1$s”</string>
    <!-- §4 Menus. -->
    <string name="ob_mn_display_settings" translatable="false">Display settings</string>
    <string name="ob_mn_close_windows" translatable="false">Close %1$d windows</string>
    <string name="ob_mn_hint_middle_click" translatable="false">Middle-click</string>
    <string name="ob_mn_window_number" translatable="false">%1$s (%2$d)</string>
</resources>
